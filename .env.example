# ── Server ────────────────────────────────────────────────
PORT=3000

# ── Database (Neon Postgres) ──────────────────────────────
# Get this from the Neon integration in your Vercel project,
# or from the Neon dashboard. Use the *pooled* connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# ── JWT secrets ───────────────────────────────────────────
TOKEN_KEY=your_access_token_secret
REFRESH_TOKEN_KEY=your_refresh_token_secret

# ── Cloudflare R2 (image / video / document storage) ──────
# R2 is S3-compatible. Get these from the Cloudflare dashboard:
#   R2_ACCOUNT_ID   — the hex id in the bucket's "S3 API" endpoint
#   R2_BUCKET       — bucket name
#   R2_ACCESS_KEY_*  — R2 → Manage R2 API Tokens → Create Account API token
#                      (Object Read & Write, scoped to this bucket)
#   R2_PUBLIC_BASE_URL — bucket → Public Development URL, or a custom domain
# Also set a CORS policy on the bucket allowing PUT from the dashboard origin,
# otherwise browser-direct video uploads fail.
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=niran-media
R2_ACCESS_KEY_ID=xxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxx
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# ── Vercel Blob (legacy) ──────────────────────────────────
# Only needed while migrating old files across to R2, and so that deleting a
# record can still clean up files that have not been migrated yet.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx


# ── Optional: seed the first admin user (npm run seed) ────
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=change_me
